# College AI Environment Variables
ENVIRONMENT=development
PROJECT_NAME="College AI"
FRONTEND_URL=http://localhost:5173

# CORS (JSON array or comma-separated list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security & JWT
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-secret

# Database URL
# For local dev without Postgres: sqlite:///./college_ai.db
# For Supabase PostgreSQL (direct or pooler):
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./college_ai.db
